---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import profileData from "../data/profile.yaml";
import conferences from "../data/conferences.yaml";
import { hero } from "../data/images";
import { getCollection } from "astro:content";
import { youtubeThumb } from "../lib/youtube";

const talks = await getCollection("talks");
const eventCount = new Set(talks.map((t) => t.data.event)).size;
const talkById = new Map(talks.map((t) => [t.id, t]));

const sessionize = profileData.social.find(
  (s: { label: string }) => s.label === "Sessionize",
)?.url;
const linkedin = profileData.social.find(
  (s: { label: string }) => s.label === "LinkedIn",
)?.url;

const stats = [
  { value: `${talks.length}`, label: "Talks delivered" },
  { value: `${eventCount}+`, label: "Conferences" },
  { value: `${profileData.books.length}`, label: "Books authored" },
  { value: "7 yrs", label: "Pulsar committer" },
];

// One row of logos; the rest of the record lives on the Speaking page.
const LOGO_ROW = 10;
const logoConfs = conferences.filter((c: { logo?: string }) => c.logo);
const shownLogos = logoConfs.slice(0, LOGO_ROW);
const moreEvents = eventCount - shownLogos.length;

type Topic = {
  title: string;
  description: string;
  deliveredAt?: string[];
  formats?: string;
  level?: string;
};
const offers = (profileData.topics as Topic[]).map((t) => ({
  ...t,
  delivered: (t.deliveredAt ?? [])
    .map((id) => talkById.get(id))
    .filter((x) => x !== undefined),
}));

const reel = (profileData.reel as string[])
  .map((id) => talkById.get(id))
  .filter((t) => t !== undefined && t.data.videoUrl);

// "Latest" merges blog posts and dated videos, newest first, so a regular
// publishing cadence fills the home page without layout changes.
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .map((p) => ({
    kind: "Post",
    title: p.data.title,
    description: p.data.description,
    date: p.data.pubDate,
    href: `/blog/${p.id}/`,
    external: false,
    thumb: undefined as string | undefined,
  }));
const datedVideos = (await getCollection("videos"))
  .filter((v) => v.data.date && v.data.url)
  .map((v) => ({
    kind: v.data.kind === "short" ? "Short" : "Video",
    title: v.data.title,
    description: v.data.description ?? "",
    date: v.data.date!,
    href: v.data.url!,
    external: true,
    thumb: youtubeThumb(v.data.url),
  }));
const latest = [...posts, ...datedVideos]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 3);

// Full-size speaker photo for organizers to download.
const photo = await getImage({ src: hero, width: 1600, format: "jpeg", quality: 85 });

const facts = [
  { label: "Role", value: `${profileData.title}, ${profileData.company.name}` },
  { label: "Apache Pulsar", value: "Committer, 7 years" },
  { label: "Talks on record", value: `${talks.length} · ${eventCount}+ events` },
  { label: "Formats", value: profileData.availableFor.join(" · ") },
];

const isoDay = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="stage overflow-hidden">
    <div
      class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 sm:px-6 md:grid-cols-[1.15fr_0.85fr] md:py-20"
    >
      <div>
        <p class="mono-label mb-6 flex items-center gap-2 border-b border-border pb-3 text-secondary">
          <span class="status-dot"></span>
          {profileData.title} · {profileData.company.name}
        </p>
        <h1 class="text-5xl leading-[1.02] sm:text-6xl md:text-7xl">
          <span class="lede">{profileData.positioning.headline}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-text">
          {profileData.positioning.subhead}
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={sessionize} target="_blank" rel="noopener noreferrer" class="btn-primary">
            Invite me to speak
          </a>
          <a href="#kit" class="btn-secondary">Speaker kit</a>
        </div>
        <dl class="mt-12 grid max-w-lg grid-cols-2 gap-6 border-t border-border pt-6 sm:grid-cols-4">
          {
            stats.map((s) => (
              <div>
                <dt class="font-display text-3xl text-secondary tabular-nums">{s.value}</dt>
                <dd class="mono-label mt-1 !text-[0.65rem] text-muted">{s.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="relative">
        <Image
          src={hero}
          alt={`${profileData.name} speaking`}
          class="relative aspect-[4/5] w-full rounded-2xl object-cover shadow-md"
          widths={[480, 800, 1000]}
          sizes="(min-width: 768px) 38vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>

    <!-- As seen at: one row -->
    <div class="border-t border-border">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-3 px-4 py-6 sm:px-6">
        <p class="mono-label mr-2 text-muted">As seen at</p>
        {
          shownLogos.map((c: { name: string; logo: string }) => (
            <span class="flex h-12 items-center rounded-xl border border-border bg-logo px-3">
              <img src={c.logo} alt={c.name} class="max-h-8 w-auto max-w-[120px] object-contain" loading="lazy" />
            </span>
          ))
        }
        {
          moreEvents > 0 && (
            <a href="/talks/" class="mono-label ml-2 text-primary hover:text-secondary">
              + {moreEvents} more events →
            </a>
          )
        }
      </div>
    </div>
  </section>

  <!-- ============ TALK MENU + BOOKING ============ -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
    <div class="reveal max-w-2xl">
      <p class="mono-label text-primary">For organizers</p>
      <h2 class="mt-2 text-3xl sm:text-4xl">Talks I'm offering</h2>
    </div>
    <div class="mt-10 grid gap-6 lg:grid-cols-[7fr_3fr]">
      <div class="grid gap-5 sm:grid-cols-2">
        {
          offers.map((o) => (
            <div class="reveal panel">
              <div class="panel-body">
                <h3 class="text-xl">{o.title}</h3>
                <p class="mt-2 text-muted">{o.description}</p>
                {(o.formats || o.level) && (
                  <p class="mono-label mt-4 text-secondary">
                    {[o.formats, o.level].filter(Boolean).join(" · ")}
                  </p>
                )}
              </div>
              {o.delivered.length > 0 && (
                <p class="panel-meta flex-wrap">
                  <span class="status-dot" />
                  Given at
                  {o.delivered.map((t, i) => (
                    <a
                      href={t.data.videoUrl ?? "/talks/"}
                      target={t.data.videoUrl ? "_blank" : undefined}
                      rel={t.data.videoUrl ? "noopener noreferrer" : undefined}
                      class="text-primary hover:text-secondary"
                    >
                      {`${t.data.event} ${t.data.year}${i < o.delivered.length - 1 ? "," : ""}`}
                    </a>
                  ))}
                </p>
              )}
            </div>
          ))
        }
      </div>

      <!-- Instrument stack: booking -->
      <aside class="reveal panel self-start lg:sticky lg:top-24">
        <div class="panel-body">
          <p class="mono-label text-muted">Book a session</p>
          <dl class="mt-4 space-y-3">
            {
              facts.map((f) => (
                <div class="border-b border-border pb-3">
                  <dt class="mono-label !text-[0.65rem] text-muted">{f.label}</dt>
                  <dd class="mt-1 text-sm text-text">{f.value}</dd>
                </div>
              ))
            }
          </dl>
          <div class="mt-5 flex flex-col gap-2">
            <a href={sessionize} target="_blank" rel="noopener noreferrer" class="btn-primary text-center">
              Invite me via Sessionize
            </a>
            <a href={linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary text-center">
              Message on LinkedIn
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ RECENT RECORDINGS ============ -->
  {
    reel.length > 0 && (
      <section id="reel" class="scroll-mt-20 border-y border-border bg-surface">
        <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
          <div class="reveal flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="mono-label text-primary">On stage</p>
              <h2 class="mt-2 text-3xl sm:text-4xl">Recent recordings</h2>
            </div>
            <a href="/talks/" class="mono-label text-primary hover:text-secondary">
              All {talks.length} talks →
            </a>
          </div>
          <div class="mt-8 grid gap-6 md:grid-cols-3">
            {reel.map((t) => {
              const thumb = youtubeThumb(t.data.videoUrl);
              return (
                <a
                  href={t.data.videoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="reveal group panel"
                >
                  {thumb && (
                    <span class="relative block aspect-video overflow-hidden bg-border">
                      <img
                        src={thumb}
                        alt=""
                        class="h-full w-full object-cover"
                        loading="lazy"
                      />
                      <span class="absolute bottom-3 left-3 rounded-full bg-secondary px-3 py-1 text-xs font-semibold text-white">
                        ▶ Watch
                      </span>
                    </span>
                  )}
                  <span class="panel-body">
                    <span class="font-display block text-lg font-semibold group-hover:text-primary">
                      {t.data.title}
                    </span>
                  </span>
                  <span class="panel-meta">
                    <span class="status-dot" />
                    {t.data.event} · {t.data.year}
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <!-- ============ LATEST (posts + videos) ============ -->
  {
    latest.length > 0 && (
      <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
        <div class="reveal flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="mono-label text-primary">New</p>
            <h2 class="mt-2 text-3xl sm:text-4xl">Latest</h2>
          </div>
          <div class="flex gap-5">
            <a href="/blog/" class="mono-label text-primary hover:text-secondary">All posts →</a>
            <a href="/videos/" class="mono-label text-primary hover:text-secondary">All videos →</a>
          </div>
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {latest.map((item) => (
            <a
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              class="reveal group panel"
            >
              {item.thumb && (
                <span class="block aspect-video overflow-hidden bg-border">
                  <img src={item.thumb} alt="" class="h-full w-full object-cover" loading="lazy" />
                </span>
              )}
              <span class="panel-body">
                <span class="font-display block text-lg font-semibold group-hover:text-primary">
                  {item.title}
                </span>
                {item.description && (
                  <span class="mt-2 block text-sm text-muted">{item.description}</span>
                )}
              </span>
              <span class="panel-meta">
                <span class="status-dot" />
                {item.kind} · <time datetime={item.date.toISOString()}>{isoDay(item.date)}</time>
              </span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <!-- ============ SPEAKER KIT ============ -->
  <section id="kit" class="scroll-mt-20 border-t border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 md:py-20">
      <div class="reveal max-w-2xl">
        <p class="mono-label text-primary">Speaker kit</p>
        <h2 class="mt-2 text-3xl sm:text-4xl">Bio, photo and books</h2>
        <p class="mt-2 text-muted">Everything an event program needs, ready to copy.</p>
      </div>
      <div class="mt-10 grid gap-6 lg:grid-cols-[7fr_3fr]">
        <div class="grid gap-6">
          <div class="reveal panel">
            <div class="panel-body">
              <div class="flex items-center justify-between gap-4">
                <h3 class="text-xl">Short bio</h3>
                <button type="button" class="copy-btn btn-secondary !py-1.5" data-copy="bio-short">Copy</button>
              </div>
              <p id="bio-short" class="mt-3 leading-relaxed">{profileData.speakerBio.short}</p>
            </div>
            <p class="panel-meta">For programs and introductions</p>
          </div>
          <div class="reveal panel">
            <div class="panel-body">
              <div class="flex items-center justify-between gap-4">
                <h3 class="text-xl">Long bio</h3>
                <button type="button" class="copy-btn btn-secondary !py-1.5" data-copy="bio-long">Copy</button>
              </div>
              <div id="bio-long" class="mt-3 space-y-3 leading-relaxed">
                {profileData.speakerBio.long.map((p: string) => <p>{p}</p>)}
              </div>
            </div>
            <p class="panel-meta">For speaker pages and press</p>
          </div>
        </div>

        <aside class="grid content-start gap-6">
          <div class="reveal panel">
            <Image
              src={hero}
              alt={`${profileData.name}, speaker photo`}
              class="aspect-[4/3] w-full object-cover"
              widths={[400, 700]}
              sizes="(min-width: 1024px) 22vw, 100vw"
            />
            <div class="panel-body">
              <a href={photo.src} download="david-kjerrumgaard-speaker-photo.jpg" class="btn-secondary block text-center">
                Download photo
              </a>
            </div>
          </div>
          <div class="reveal panel">
            <div class="panel-body">
              <p class="mono-label text-muted">Books</p>
              <ul class="mt-3 space-y-3">
                {
                  profileData.books.map((b: { title: string; url: string; role: string; publisher: string }) => (
                    <li>
                      <a href={b.url} target="_blank" rel="noopener noreferrer" class="font-display font-semibold hover:text-primary">
                        {b.title}
                      </a>
                      <span class="mono-label block !text-[0.65rem] text-muted">
                        {b.role} · {b.publisher}
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- ============ BOOKING CTA ============ -->
  <section class="px-4 py-16 sm:px-6">
    <div class="panel reveal mx-auto max-w-6xl px-6 py-12 text-center sm:py-16">
      <h2 class="text-3xl text-secondary sm:text-4xl">Let's work together</h2>
      <p class="mx-auto mt-3 max-w-xl text-muted">
        Available for {profileData.availableFor.join(", ").toLowerCase()}.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href={sessionize} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Invite me to speak
        </a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary">
          Connect on LinkedIn
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Reveal-on-scroll
  const els = document.querySelectorAll(".reveal");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add("is-visible");
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: "0px 0px -10% 0px" },
    );
    els.forEach((el) => io.observe(el));
  } else {
    els.forEach((el) => el.classList.add("is-visible"));
  }

  // Copy-to-clipboard for the speaker bios.
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const el = document.getElementById(btn.dataset.copy ?? "");
      if (!el) return;
      const text = Array.from(el.querySelectorAll("p"))
        .map((p) => p.textContent?.trim())
        .join("\n\n") || el.textContent?.trim() || "";
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "Copied";
      } catch {
        btn.textContent = "Select & copy";
      }
      setTimeout(() => (btn.textContent = "Copy"), 2000);
    });
  });
</script>
