---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { getCollection } from "astro:content";

const allTalks = await getCollection("talks");

// Counted in totals, but only `display !== false` talks appear in the list.
const talks = allTalks
  .filter((t) => t.data.display !== false)
  .sort((a, b) => {
    if (b.data.year !== a.data.year) return b.data.year - a.data.year;
    return a.data.event.localeCompare(b.data.event);
  });

const years = [...new Set(talks.map((t) => t.data.year))].sort((a, b) => b - a);
---

<BaseLayout
  title="Talks"
  description="Conference talks delivered around the world on real-time data, messaging, and streaming."
>
  <PageHeader
    eyebrow="Speaking"
    title="Talks"
    description={`${allTalks.length} conference appearances around the globe. Filter by year, or follow the links to watch a recording.`}
  >
    <a href="/slides/" class="btn-secondary mt-6">All slide decks →</a>
  </PageHeader>

  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <!-- Year filter -->
    <div class="flex flex-wrap gap-2" id="year-filters">
      <button
        type="button"
        data-year="all"
        class="year-btn mono-label rounded-full border border-secondary bg-secondary px-3.5 py-1.5 text-white"
        >All</button
      >
      {
        years.map((y) => (
          <button
            type="button"
            data-year={y}
            class="year-btn mono-label rounded-full border border-border bg-surface px-3.5 py-1.5 text-muted hover:text-primary"
          >
            {y}
          </button>
        ))
      }
    </div>

    <ul class="panel mt-8 divide-y divide-border px-6">
      {
        talks.map((talk) => (
          <li
            class="talk-row flex flex-wrap items-baseline justify-between gap-2 py-4"
            data-year={talk.data.year}
          >
            <div class="min-w-0">
              <p class="text-lg font-medium">
                {talk.data.title ?? talk.data.event}
              </p>
              {talk.data.title && (
                <p class="text-sm text-slate-500 dark:text-slate-400">
                  {talk.data.event}
                </p>
              )}
            </div>
            <div class="flex shrink-0 items-center gap-3">
              <span class="mono-label text-muted">
                {talk.data.year}
              </span>
              {talk.data.videoUrl && (
                <a
                  href={talk.data.videoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 mono-label rounded-full border border-border px-2.5 py-1 !text-[0.65rem] text-accent-600 dark:text-accent-400 hover:border-primary"
                >
                  ▶ Watch
                </a>
              )}
              {talk.data.slidesUrl && (
                <a
                  href={talk.data.slidesUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 mono-label rounded-full border border-border px-2.5 py-1 !text-[0.65rem] text-slate-600 dark:text-slate-300 hover:border-primary"
                >
                  ▤ Slides
                </a>
              )}
              {talk.data.repoUrl && (
                <a
                  href={talk.data.repoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 mono-label rounded-full border border-border px-2.5 py-1 !text-[0.65rem] text-slate-600 dark:text-slate-300 hover:border-primary"
                >
                  {"</>"} Code
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script is:inline>
  const filters = document.getElementById("year-filters");
  const rows = Array.from(document.querySelectorAll(".talk-row"));
  filters?.addEventListener("click", (e) => {
    const btn = e.target.closest(".year-btn");
    if (!btn) return;
    const year = btn.dataset.year;
    document.querySelectorAll(".year-btn").forEach((b) => {
      const active = b === btn;
      b.classList.toggle("border-secondary", active);
      b.classList.toggle("bg-secondary", active);
      b.classList.toggle("text-white", active);
      b.classList.toggle("border-border", !active);
      b.classList.toggle("bg-surface", !active);
      b.classList.toggle("text-muted", !active);
    });
    rows.forEach((row) => {
      row.style.display =
        year === "all" || row.dataset.year === year ? "" : "none";
    });
  });
</script>
