---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}
const { eyebrow, title, description } = Astro.props;
---

<section class="stage relative overflow-hidden">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6 md:py-16">
    {
      eyebrow && (
        <p class="mono-label mb-5 flex items-center gap-2 border-b border-border pb-3 text-secondary">
          <span class="status-dot" />
          {eyebrow}
        </p>
      )
    }
    <h1 class="text-4xl text-secondary sm:text-5xl md:text-6xl">{title}</h1>
    {
      description && (
        <p class="mt-4 max-w-2xl text-lg text-muted">{description}</p>
      )
    }
    <slot />
  </div>
</section>
