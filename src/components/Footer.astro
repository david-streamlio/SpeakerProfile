---
import profileData from "../data/profile.yaml";
const year = new Date().getFullYear();
---

<footer
  class="border-t border-border py-8"
>
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 px-4 mono-label text-muted sm:flex-row sm:px-6"
  >
    <p>© {year} {profileData.name}</p>
    <div class="flex gap-4">
      {
        profileData.social.map((s: { label: string; url: string }) => (
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-primary"
          >
            {s.label}
          </a>
        ))
      }
    </div>
  </div>
</footer>
