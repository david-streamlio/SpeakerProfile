---
import profileData from "../data/profile.yaml";

// Slides and Podcasts stay live, linked from Speaking and Media.
const nav = [
  { label: "Speaking", href: "/talks/", also: ["/slides/"] },
  { label: "Writing", href: "/blog/" },
  { label: "Media", href: "/videos/", also: ["/podcasts/"] },
  { label: "Code", href: "/projects/" },
];

const path = Astro.url.pathname;
const isActive = (item: { href: string; also?: string[] }) =>
  [item.href, ...(item.also ?? [])].some((h) => path.startsWith(h));

const sessionize = profileData.social.find(
  (s: { label: string }) => s.label === "Sessionize",
)?.url;
---

<header
  class="sticky top-0 z-50 border-b border-border bg-background/85 backdrop-blur"
>
  <div
    class="mx-auto flex max-w-5xl flex-col gap-2 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4 sm:px-6"
  >
    <a href="/" class="font-display text-xl">
      {profileData.name}
    </a>

    <nav class="mono-label -mx-2 flex items-center gap-1 overflow-x-auto whitespace-nowrap sm:mx-0 sm:gap-2">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "rounded-full px-3 py-1.5",
              isActive(item)
                ? "bg-secondary text-white"
                : "text-muted hover:text-primary",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      {
        sessionize && (
          <a
            href={sessionize}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary ml-2 hidden !py-1.5 sm:inline-block"
          >
            Invite me
          </a>
        )
      }
    </nav>
  </div>
</header>
